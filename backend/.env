# QAU CS Academic Advisor Backend Configuration

# App Settings
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://qau_advisor:qau_advisor_local@localhost:55432/qau_advisor

# CORS
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# NLP Configuration - Use baseline (pattern-based) classifier
NLP_CLASSIFIER_BACKEND=baseline
# NLP_CLASSIFIER_BACKEND=transformer  # Use this when model is fixed

# Embedding
EMBEDDING_PROVIDER=sentence-transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Auth
AUTH_SECRET=qau-local-demo-change-before-production-2026
